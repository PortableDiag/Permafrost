<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Permafrost" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/frost_primary</item>
        <item name="colorPrimaryDark">@color/frost_primary_dark</item>
        <item name="colorSecondary">@color/frost_accent</item>
    </style>

    <style name="Theme.Permafrost.Transparent" parent="Theme.Permafrost">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- The mono palettes (Terminal, Amber Terminal, Phosphor Green, Phosphor P31)
         set the whole type ramp in monospace, applied on top of the palette. -->
    <style name="ThemeOverlay.Permafrost.Mono" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="fontFamily">monospace</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Permafrost.Mono.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Permafrost.Mono.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Permafrost.Mono.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Permafrost.Mono.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Permafrost.Mono.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Permafrost.Mono.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Permafrost.Mono.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Permafrost.Mono.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Permafrost.Mono.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Permafrost.Mono.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Permafrost.Mono.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Permafrost.Mono.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Permafrost.Mono.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Permafrost.Mono.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Permafrost.Mono.LabelSmall</item>
